rter", "uuid": "export_credits_to_postgres"}, "/home/src/mage_pipeline/data_loaders/get_watermark.py:data_loader:python:home/src/mage pipeline/data loaders/get watermark": {"content": "from os import path\n\nfrom datetime import datetime\n\nfrom mage_ai.data_preparation.decorators import data_loader\nfrom mage_ai.io.config import ConfigFileLoader\nfrom mage_ai.io.postgres import Postgres\nfrom mage_ai.settings.repo import get_repo_path\n\n\n@data_loader\ndef load_data(*args, **kwargs):\n    config_path = path.join(get_repo_path(), 'io_config.yaml')\n    query = \"\"\"\n        SELECT lset\n        FROM control.etl_watermark\n        WHERE pipeline_name = 'tmdb_incremental'\n    \"\"\"\n\n    with Postgres.with_config(ConfigFileLoader(config_path, 'default')) as loader:\n        watermark = loader.load(query)\n\n    if watermark.empty:\n        raise ValueError(\n            \"No watermark found for pipeline 'tmdb_incremental'.\"\n        )\n\n    return {\n        'lset': watermark.iloc[0]['lset'],\n        'cet': datetime.now(),\n    }\n", "file_path": "/home/src/mage_pipeline/data_loaders/get_watermark.py", "language": "python", "type": "data_loader", "uuid": "get_watermark"}, "/home/src/mage_pipeline/data_loaders/load_new_batch.py:data_loader:python:home/src/mage pipeline/data loaders/load new batch": {"content": "import pandas as pd\n\nfrom mage_ai.data_preparation.decorators import data_loader\n\n\n@data_loader\ndef load_data(*args, **kwargs):\n    return pd.read_csv('data/raw/tmdb_new_batch.csv')\n", "file_path": "/home/src/mage_pipeline/data_loaders/load_new_batch.py", "language": "python", "type": "data_loader", "uuid": "load_new_batch"}, "/home/src/mage_pipeline/data_exporters/update_watermark.py:data_exporter:python:home/src/mage pipeline/data exporters/update watermark": {"content": "from os import path\n\nfrom mage_ai.data_preparation.decorators import data_exporter\nfrom mage_ai.io.config import ConfigFileLoader\nfrom mage_ai.io.postgres import Postgres\nfrom mage_ai.settings.repo import get_repo_path\n\n\n@data_exporter\ndef update_watermark(data, **kwargs):\n    if not isinstance(data, dict) or 'cet' not in data:\n        raise ValueError(\"Expected watermark data containing a 'cet' value.\")\n\n    cet = data['cet']\n    if cet is None:\n        raise ValueError(\"The watermark 'cet' value cannot be None.\")\n\n    config_path = path.join(get_repo_path(), 'io_config.yaml')\n    query = \"\"\"\n        UPDATE control.etl_watermark\n        SET lset = %s\n        WHERE pipeline_name = 'tmdb_incremental'\n    \"\"\"\n\n    with Postgres.with_config(ConfigFileLoader(config_path, 'default')) as loader:\n        loader.execute(query, (cet,))\n", "file_path": "/home/src/mage_pipeline/data_exporters/update_watermark.py", "language": "python", "type": "data_exporter", "uuid": "update_watermark"}, "/home/src/mage_pipeline/data_exporters/export_incremental_stage.py:data_exporter:python:home/src/mage pipeline/data exporters/export incremental stage": {"content": "from os import path\n\nfrom mage_ai.data_preparation.decorators import data_exporter\nfrom mage_ai.io.config import ConfigFileLoader\nfrom mage_ai.io.postgres import Postgres\nfrom mage_ai.settings.repo import get_repo_path\n\n\n@data_exporter\ndef export_data_to_postgres(df, **kwargs):\n    config_path = path.join(get_repo_path(), 'io_config.yaml')\n\n    with Postgres.with_config(ConfigFileLoader(config_path, 'default')) as loader:\n        loader.export(\n            df,\n            'stage',\n            'stg_tmdb_movies',\n            if_exists='append',\n            index=False,\n        )\n", "file_path": "/home/src/mage_pipeline/data_exporters/export_incremental_stage.py", "language": "python", "type": "data_exporter", "uuid": "export_incremental_stage"}}, "custom_block_template": {}, "mage_template": {"data_loaders/airtable.py:data_loader:python:Airtable:Load a Table from Airtable App.": {"block_type": "data_loader", "description": "Load a Table from Airt