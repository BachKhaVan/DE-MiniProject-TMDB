{
  "id": "Q6SQL",
  "query": "\nSELECT d.decade,d.month,d.month_name,count(*) AS valid_movies,\n sum(f.profit) AS total_profit,\n percentile_cont(0.5) WITHIN GROUP(ORDER BY f.roi::float8) AS median_roi\nFROM dds.fact_movie f JOIN dds.dim_date d USING(date_sk)\nWHERE f.is_finance_valid=1 AND d.month IS NOT NULL\nGROUP BY d.decade,d.month,d.month_name\nORDER BY d.decade,d.month",
  "column_names": [
    "decade",
    "month",
    "month_name",
    "valid_movies",
    "total_profit",
    "median_roi"
  ],
