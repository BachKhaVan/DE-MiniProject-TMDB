{
  "id": "Q7SQL",
  "query": "\nSELECT c.country_name,m.country_type,l.language_group,\n count(DISTINCT f.movie_sk) AS valid_movies,\n percentile_cont(0.5) WITHIN GROUP(ORDER BY f.roi::float8) AS roi_median\nFROM dds.fact_movie f JOIN dds.dim_movie m USING(movie_sk)\nJOIN dds.dim_language l USING(language_sk)\nJOIN dds.bridge_movie_country bc USING(movie_sk)\nJOIN dds.dim_country c USING(country_sk)\nWHERE f.is_finance_valid=1\nGROUP BY c.country_name,m.country_type,l.language_group\nORDER BY c.country_name,m.country_type,l.language_group",
  "column_names": [
    "country_name",
    "country_type",
    "language_group",
    "valid_movies",
    "roi_median"
  ],
