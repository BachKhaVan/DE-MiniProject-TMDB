{
  "id": "BI09",
  "query": "\nSELECT c.company_name,count(DISTINCT f.movie_sk) AS valid_movies,\n sum(f.revenue*b.weight_factor) AS weighted_revenue,\n sum(f.revenue) AS full_revenue,\n percentile_cont(0.5) WITHIN GROUP(ORDER BY f.roi::float8) AS roi_median\nFROM dds.fact_movie f JOIN dds.bridge_movie_company b USING(movie_sk)\nJOIN dds.dim_company c USING(company_sk)\nWHERE f.is_finance_valid=1\nGROUP BY c.company_name HAVING count(DISTINCT f.movie_sk)>=5\nORDER BY weighted_revenue DESC NULLS LAST,c.company_name LIMIT 20",
  "column_names": [
    "company_name",
    "valid_movies",
    "weighted_revenue",
    "full_revenue",
    "roi_median"
  ],
