{
  "id": "Q2SQL",
  "query": "\nSELECT l.language_group,l.language_name,count(*) AS movies,\n percentile_cont(0.5) WITHIN GROUP (ORDER BY f.popularity::float8) AS median_popularity,\n percentile_cont(0.5) WITHIN GROUP (ORDER BY f.vote_average::float8) AS median_rating,\n sum(f.vote_count) AS total_votes\nFROM dds.fact_movie f JOIN dds.dim_language l USING(language_sk)\nWHERE f.vote_count>=100 AND f.vote_average IS NOT NULL\nGROUP BY l.language_group,l.language_name ORDER BY median_popularity DESC NULLS LAST,l.language_name",
  "column_names": [
    "language_group",
    "language_name",
    "movies",
    "median_popularity",
    "median_rating",
    "total_votes"
