{
  "id": "Q3SQL",
  "query": "\nSELECT d.decade,g.genre_name,count(DISTINCT f.movie_sk) AS valid_movies,\n sum(f.revenue*bg.weight_factor) AS weighted_revenue,\n sum(f.profit*bg.weight_factor) AS weighted_profit\nFROM dds.fact_movie f JOIN dds.dim_date d USING(date_sk)\nJOIN dds.bridge_movie_genre bg USING(movie_sk) JOIN dds.dim_genre g USING(genre_sk)\nWHERE f.is_finance_valid=1 GROUP BY d.decade,g.genre_name\nORDER BY d.decade,g.genre_name",
  "column_names": [
    "decade",
    "genre_name",
    "valid_movies",
    "weighted_revenue",
    "weighted_profit"
  ],
