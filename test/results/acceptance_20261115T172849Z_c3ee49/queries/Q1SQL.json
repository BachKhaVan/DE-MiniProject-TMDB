{
  "id": "Q1SQL",
  "query": "\nSELECT m.runtime_band,g.genre_name,count(DISTINCT f.movie_sk) AS movie_count,\n avg(f.runtime) AS avg_runtime,\n percentile_cont(0.5) WITHIN GROUP(ORDER BY f.vote_average::float8) AS median_rating\nFROM dds.fact_movie f JOIN dds.dim_movie m USING(movie_sk)\nJOIN dds.bridge_movie_genre bg USING(movie_sk) JOIN dds.dim_genre g USING(genre_sk)\nWHERE f.vote_count>=100 AND f.vote_average IS NOT NULL\nGROUP BY m.runtime_band,g.genre_name ORDER BY m.runtime_band,g.genre_name",
  "column_names": [
    "runtime_band",
    "genre_name",
    "movie_count",
    "avg_runtime",
    "median_rating"
  ],
