{
  "id": "BI07",
  "query": "\nSELECT l.language_name,g.genre_name,count(DISTINCT f.movie_sk) AS rated_movies,\n percentile_cont(0.5) WITHIN GROUP(ORDER BY f.popularity::float8) AS median_popularity,\n percentile_cont(0.5) WITHIN GROUP(ORDER BY f.vote_average::float8) AS median_rating\nFROM dds.fact_movie f JOIN dds.dim_language l USING(language_sk)\nJOIN dds.bridge_movie_genre bg USING(movie_sk) JOIN dds.dim_genre g USING(genre_sk)\nWHERE f.vote_count>=100 AND f.vote_average IS NOT NULL\nGROUP BY l.language_name,g.genre_name ORDER BY l.language_name,g.genre_name",
  "column_names": [
    "language_name",
    "genre_name",
    "rated_movies",
    "median_popularity",
    "median_rating"
  ],
